DATABASE_URL="postgresql://speakcoach:speakcoach@localhost:5432/speakcoach?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3001
# Comma-separated allowed browser origins. Same-host nginx: use your public site URL.
CORS_ORIGIN="http://localhost:5173"

# Providers (Strategy pattern)
# Scoring: sarvam | gemini (gemini recommended if sarvam-105b returns empty content)
CHAT_PROVIDER=gemini
VOICE_PROVIDER=sarvam

# Sarvam Voice Agents (sk_samvaad_…) — live calls via /api/sarvam proxy
SARVAM_VOICE_API_KEY=

# Sarvam Chat Completions (platform/dashboard key — NOT sk_samvaad_)
# Required when CHAT_PROVIDER=sarvam
SARVAM_CHAT_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b

# Gemini (optional — set CHAT_PROVIDER=gemini and/or VOICE_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
