DATABASE_URL="postgresql://rolesmith:rolesmith@localhost:5432/rolesmith?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3001
# Comma-separated allowed browser origins. Same-host nginx: use your public site URL.
CORS_ORIGIN="http://localhost:5173"

# Scoring: gemini | sarvam
CHAT_PROVIDER=gemini

# Optional — only when CHAT_PROVIDER=sarvam
SARVAM_CHAT_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b

# Gemini Live practice — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_VOICE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Hard cap for any Live practice call (per-scenario practiceCallMin is used under this)
GEMINI_LIVE_MAX_CALL_MINUTES=25

# Platform admin (upserted by prisma seed) — change password in production
ADMIN_EMAIL=admin@rolesmith.local
ADMIN_PASSWORD=RoleSmithAdmin1!
ADMIN_DISPLAY_NAME=RoleSmith Admin
